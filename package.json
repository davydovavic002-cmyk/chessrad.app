{
  "name": "chessrad",
  "version": "1.0.0",
  "description": "ChessRad — шахматная платформа для обучения",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "build:start": "npm run build && node server.js",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "chess.js": "^0.10.3",
    "connect-sqlite3": "^0.9.15",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  }
