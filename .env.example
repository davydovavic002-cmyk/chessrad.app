JWT_SECRET=your-secret-key-here
NODE_ENV=development
# Local dev
PORT=3569
PUBLIC_ORIGIN=http://127.0.0.1:3569

# Production (chessrad.app:3569 via nginx → Node on 13569):
# PORT=13569
# PUBLIC_ORIGIN=https://chessrad.app:3569
# NODE_ENV=production

# Set to true only for local dev without login (auto user "dev")
AUTH_BYPASS=false

# Optional email (lesson reports, homework, reminders — also 1hr before lesson/tournament)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=ChessRad <noreply@chessrad.app>
