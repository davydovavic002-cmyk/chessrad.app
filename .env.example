JWT_SECRET=your-secret-key-here-min-16-chars
SESSION_SECRET=your-session-secret-min-16-chars
NODE_ENV=development
# Local dev
PORT=3011
PUBLIC_ORIGIN=http://127.0.0.1:3011

# Production (chessrad.app:3569 via nginx → Node on 13569):
# PORT=13569
# PUBLIC_ORIGIN=https://chessrad.app:3569
# NODE_ENV=production

# Invite required for teacher self-registration (leave empty = teacher signup disabled)
# TEACHER_INVITE_CODE=ask-admin-for-code

# Set to true only for local dev without login (auto user "dev")
AUTH_BYPASS=false

# Optional email (lesson reports, homework, reminders)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=ChessRad <noreply@chessrad.app>
